{
    "version": "6.9.0",
    "configurations": [
        {
            "name": "mdc",
            "type": "arm-debugger.configdb",
            "request": "launch",
            "cdbEntry": "Arm FVP::MPS2_Cortex_M4::Bare Metal Debug::Bare Metal Debug::Cortex-M4",
            "runControl": {
                "debugFromSymbol": "main"
            },
            "programs": [
                "${command:arm-debugger.getApplicationFiles}"
            ]
        },
        {
            "name": "Arm-FVP@GDB (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/Lab01_LuisCordova_23012122/ARMCM4/Debug/Lab01_LuisCordova_23012122.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "tbreak main"
            ],
            "target": {
                "server": "FVP_MPS2_Cortex-M4",
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${env:AVH_FVP_PLUGINS}/GDBServer.dll",
                    "-C",
                    "GDBServer.port=3333",
                    "-a",
                    "out/Lab01_LuisCordova_23012122/ARMCM4/Debug/Lab01_LuisCordova_23012122.hex"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "Arm-FVP@GDB (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/Lab01_LuisCordova_23012122/ARMCM4/Debug/Lab01_LuisCordova_23012122.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}